# ==============================================================================
# ResumeIQ - Docker Compose Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your local or production environment.
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Configuration (Backend Only - SENSITIVE)
# ------------------------------------------------------------------------------
# Google Gemini API key used by Spring AI to summarize, extract skills, and power chat.
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Identity Configuration
# ------------------------------------------------------------------------------
# Public Google Client ID created in Google Cloud Console (project: resumeiq-512604)
# Used both by the frontend Google Sign-In SDK and backend token verification.
# IMPORTANT: Never place client secrets in the frontend.
GOOGLE_CLIENT_ID=837596203973-dnhf7rp7qgpte6bbafunvshu2b0ghmui.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=837596203973-dnhf7rp7qgpte6bbafunvshu2b0ghmui.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# OPTION A: Default local containerized PostgreSQL (managed by Docker Compose)
POSTGRES_DB=resumeiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://postgres:5432/resumeiq
DB_USERNAME=postgres
DB_PASSWORD=postgres

# OPTION B: External Neon PostgreSQL (Uncomment and replace to connect to Neon)
# DATABASE_URL=jdbc:postgresql://ep-rapid-river-b33cn2dy-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=your_neon_db_username
# DB_PASSWORD=your_neon_db_password

# ------------------------------------------------------------------------------
# 4. Service Port Mappings (Host access)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080
